#!/bin/sh
# Structural check before a commit. Install: git config core.hooksPath infra/hooks
set -eu

# Pick a candidate by whether it actually runs, not by whether it exists.
# On Windows, python3 may be the Microsoft Store install stub: it exists but does not run.
PY=""
for candidate in python3 python py; do
  if command -v "$candidate" >/dev/null 2>&1 &&
     "$candidate" -c "import sys; sys.exit(0)" >/dev/null 2>&1; then
    PY="$candidate"
    break
  fi
done

if [ -z "$PY" ]; then
  echo "pre-commit: found no runnable Python (python3, python, and py all failed)." >&2
  echo "  Install Python 3.10+. Do not skip with --no-verify - that is the same as having no gate." >&2
  exit 1
fi

exec "$PY" infra/research-lint.py
