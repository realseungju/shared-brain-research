#!/bin/sh
# commit 전 구조 검사. 설치: git config core.hooksPath infra/hooks
set -eu

# 후보를 "존재하는가"가 아니라 "실제로 실행되는가"로 고른다.
# Windows 의 python3 는 Microsoft Store 설치 유도 스텁일 수 있고, 그건 존재하지만 돌지 않는다.
PY=""
for candidate in python3 python py; do
  if command -v "$candidate" >/dev/null 2>&1 &&
     "$candidate" -c "import sys; sys.exit(0)" >/dev/null 2>&1; then
    PY="$candidate"
    break
  fi
done

if [ -z "$PY" ]; then
  echo "pre-commit: 실행 가능한 Python 을 찾지 못했다 (python3/python/py 모두 실패)." >&2
  echo "  Python 3.10+ 를 설치하라. --no-verify 로 넘기지 마라 — 게이트가 없는 것과 같다." >&2
  exit 1
fi

exec "$PY" infra/brain-lint.py
