* text=auto
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
infra/hooks/* text eol=lf
system/sessions/*.md text eol=lf

# sessions/index.md is a log that appends one line at its tail. When two people (or two
# worktrees) each close a session and then merge, they conflict for certain in the same region.
# union = keep both sides' lines. It is exactly the right driver for an append-only log: the
# index is read by "skimming the tail", so mixed order is harmless and losing nothing is right.
# The eol=lf above must stay with it — if CRLF gets into the blob, every line differs byte by
# byte, union stops working, and real conflict markers appear.
system/sessions/index.md merge=union
