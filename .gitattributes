* text=auto
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
infra/hooks/* text eol=lf
system/sessions/*.md text eol=lf

# sessions/index.md 는 꼬리에 한 줄씩 append 하는 로그다. 두 사람(또는 두 워크트리)이
# 각자 session 을 닫은 뒤 합치면 같은 줄 영역에서 확정적으로 충돌한다.
# union = 양쪽 줄을 모두 보존. append-only 로그에 정확히 맞는 드라이버이며,
# index 는 "꼬리를 훑는" 용도라 순서가 섞여도 무해하고 유실이 0인 쪽이 옳다.
# 위 eol=lf 가 함께 있어야 한다 — CRLF 가 blob 에 박히면 매 줄이 byte 단위로 달라져
# union 이 무력화되고 실제 conflict marker 가 뜬다.
system/sessions/index.md merge=union
